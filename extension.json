{
	"name": "Simple Paste Image",
	"version": "0.1.0",
	"author": [
		"Urfiner (Nikolai Kochkin)"
	],
	"url": "https://www.mediawiki.org/wiki/Extension:SimplePasteImage",
	"type": "media",
	"description": "To simplify pasting documents with images in VisualEditor",
	"descriptionmsg": "simplepasteimage-desc",
	"requires": {
		"MediaWiki": ">= 1.39.2",
		"extensions": {
			"VisualEditor": "*"
		}
	},
	"MessagesDirs": {
		"SimplePasteImage": [
			"i18n"
		]
	},
	"config": {},
	"ResourceFileModulePaths": {
		"localBasePath": "modules",
		"remoteExtPath": "SimplePasteImage/modules"
	},
	"ResourceModules": {
		"ext.simplePasteImage.imageHandler": {
			"localBasePath": "modules/imageHandler",
			"remoteExtPath": "SimplePasteImage/modules/imageHandler",
			"packageFiles": [
				"imageHandler.js"
			],
			"targets": [
				"desktop"
			]
		},
		"ext.simplePasteImage.imagePasteProcessor": {
			"localBasePath": "modules/imagePasteProcessor",
			"remoteExtPath": "SimplePasteImage/modules/imagePasteProcessor",
			"packageFiles": [
				"imagePasteProcessor.js"
			],
			"dependencies": [
				"ext.simplePasteImage.imageHandler",
				"ext.visualEditor.mwcore",
				"ext.visualEditor.mwimage",
				"mediawiki.api",
				"mediawiki.notification"
			],
			"targets": [
				"desktop"
			],
			"messages": [
				"simplepasteimage-uploading",
				"simplepasteimage-upload-error",
				"simplepasteimage-image-failed"
			]
		}
	},
	"attributes": {
		"VisualEditor": {
			"PluginModules": [
				"ext.simplePasteImage.imagePasteProcessor"
			]
		}
	},
	"manifest_version": 2
}
